# AgentRails — example environment file.
# Copy this to `.env` (which is gitignored) and fill in real values.
# NEVER commit real credentials. AgentRails itself never reads the network;
# these are for YOUR broker/notification integration around it.

# --- Broker API (example: Alpaca paper trading) ---
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Optional: Telegram for human-in-the-loop approvals ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
